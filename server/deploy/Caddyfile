# Caddy holt und erneuert das TLS-Zertifikat automatisch.
# Voraussetzung: Du kontrollierst die Domain und ein DNS-A/AAAA-Eintrag
# für api.picast.com zeigt auf diesen Server. Ports 80 und 443 offen.
api.picast.com {
	request_body {
		max_size 3MB
	}
	# Kunibert lauscht nur lokal; nach außen spricht ausschließlich Caddy.
	reverse_proxy 127.0.0.1:8000 {
		transport http {
			read_timeout 120s
		}
	}
	# Keine Anfrageinhalte protokollieren.
	log {
		output discard
	}
}
