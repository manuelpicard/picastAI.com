# /etc/kunibert/kunibert.env   –   Besitzer root, Rechte 600 (systemd liest sie vor dem Rechteabbau)
#
# Schlüssel des Sprachmodell-Anbieters: bleibt auf dem Server, nie auf dem Pi, nie im Git.
OPENAI_API_KEY=hier-eigenen-schluessel-eintragen
# Optional ein anderer OpenAI-kompatibler Anbieter:
# OPENAI_BASE_URL=https://api.openai.com/v1

# Pfade (passend zur systemd-Unit: nur /var/lib/kunibert ist beschreibbar)
KUNIBERT_DEVICES_FILE=/var/lib/kunibert/devices.json
KUNIBERT_PIPER_VOICE=/opt/kunibert/server/voices/de_DE-thorsten-medium.onnx
HF_HOME=/var/lib/kunibert/hf-cache

# Modelle: Geschichten sprachlich stark, Antworten schnell
KUNIBERT_STORY_MODEL=gpt-5
KUNIBERT_STORY_REASONING=minimal
KUNIBERT_ANSWER_MODEL=gpt-5-mini
KUNIBERT_ANSWER_REASONING=low
KUNIBERT_LLM_TIMEOUT=30
KUNIBERT_WHISPER_MODEL=small

# Verhalten
KUNIBERT_AGE="sechs bis zehn"
KUNIBERT_PARTS_PER_EPISODE=5
KUNIBERT_AUDIO_TTL=120
KUNIBERT_RATE_LIMIT=30
# Nur zur Fehlersuche: Antworttext zusätzlich im JSON zurückgeben
KUNIBERT_DIAGNOSTIC_TEXT=0
