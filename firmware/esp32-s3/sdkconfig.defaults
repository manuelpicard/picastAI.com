# Ziel: ESP32-S3 (Entwicklungsboard noch nicht festgelegt, siehe README.md)
CONFIG_IDF_TARGET="esp32s3"
# TLS: Zertifikate der üblichen Zertifizierungsstellen (für Let's Encrypt hinter Caddy)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_TLS_INSECURE=n
# Genug Stack für TLS im Haupt-Task (der TLS-Handshake läuft im aufrufenden Task)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# Aufnahmepuffer (15 s = 480 KB) liegt im PSRAM. Fehlt PSRAM, startet das Gerät trotzdem
# und nimmt kürzer auf (siehe kb_audio.c).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
