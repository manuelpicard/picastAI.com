# ==============================================================================
# Ritter Kunibert – Umgebungsvariablen (Environmental Variables)
# ==============================================================================
# Diese Datei dient als Vorlage (.env.example).
# Auf dem Server unter .env oder /etc/kunibert/kunibert.env anlegen (chmod 600).
# Sicherheitsregel: API-Schlüssel bleiben IMMER auf dem Server, nie auf dem Pi!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Netzwerk & Server
# ------------------------------------------------------------------------------
# Port, an dem der Server lauscht (Standard: 3000; nach außen nur über Caddy)
PORT=3000
# Host-Interface (0.0.0.0 bindet an alle Netzwerkkarten)
HOST=0.0.0.0
# Browser-Ursprünge mit Zugriff auf API-Routen, kommagetrennt; leer = keine Cross-Origin-Freigabe
PICASTAI_CORS_ORIGINS=
# Ursprung, unter dem die Geräte den Server erreichen, z. B. https://kunibert.example.
# Daraus baut der Server die audio_url. Hinter einem Proxy dringend setzen: der Pi-Client
# lehnt eine audio_url mit anderem Schema oder Host ab (typisch: http statt https).
PICASTAI_PUBLIC_BASE_URL=
# Express "trust proxy" (leer/false = aus; true; Anzahl Proxy-Hops, z. B. 1; oder loopback).
# Nur nötig, wenn PICASTAI_PUBLIC_BASE_URL nicht gesetzt ist.
PICASTAI_TRUST_PROXY=

# ------------------------------------------------------------------------------
# 1a. picastAI-Geräteauthentifizierung
# ------------------------------------------------------------------------------
# Der Raspberry Pi sendet diese Werte als X-Device-ID und Bearer-Token.
# In Produktion setzen und niemals in Git committen.
PICASTAI_DEVICE_ID=prototype-001
PICASTAI_DEVICE_TOKEN=
PICASTAI_DEVICE_NAME=picastAI Raspberry-Pi-Prototyp

# Mindestens 32 zufällige Zeichen, nur serverseitig setzen (z. B. openssl rand -hex 32).
# Nicht in Git eintragen und nicht in Build-/Frontend-Variablen kopieren.
PICASTAI_ADMIN_TOKEN=

# ------------------------------------------------------------------------------
# 2. KI- & Sprachmodell-Anbieter (Server-seitig)
# ------------------------------------------------------------------------------
# Sprachmodell für Antworten und Geschichten: anthropic | none.
# Leer = Anthropic, wenn ANTHROPIC_API_KEY gesetzt ist. Gemini gibt es nicht mehr (Googles Bedingungen
# schließen Anwendungen für unter 18-Jährige aus). Siehe docs/LLM-Anbieter.md.
PICASTAI_LLM_PROVIDER=
PICASTAI_LLM_TIMEOUT_MS=30000
# Anthropic (Claude) API-Schlüssel, nur serverseitig
ANTHROPIC_API_KEY=
PICASTAI_ANTHROPIC_MODEL=claude-sonnet-5-5
# Spracherkennung und Sprachausgabe: je ein Dienst mit OpenAI-kompatibler Schnittstelle, in der Regel
# ein eigener Server (z. B. Speaches, siehe deploy/EINRICHTUNG.md). Leer = aus, es gibt keinen Standarddienst.
# Adresse bis einschließlich /v1, z. B. http://127.0.0.1:8000/v1. Ein Schlüssel ist nur nötig, wenn der Dienst ihn verlangt.
PICASTAI_STT_URL=
PICASTAI_STT_API_KEY=
PICASTAI_STT_MODEL=
# Hinweistext für die Spracherkennung. Empfohlen: "Ritter Kunibert" (ohne ihn wurde "Kunibert" im Test nie richtig erkannt).
PICASTAI_STT_PROMPT=
PICASTAI_TTS_URL=
PICASTAI_TTS_API_KEY=
PICASTAI_TTS_MODEL=
PICASTAI_TTS_VOICE=
# Alternative Sprachausgabe: Google Cloud Text-to-Speech (Chirp 3 HD, EU-Endpunkt). Nur der Antworttext
# geht hinaus, nie die Kinderstimme. PICASTAI_TTS_PROVIDER=google schaltet um; PICASTAI_TTS_URL/_MODEL/_VOICE
# gelten dann nicht. Schlüssel nur serverseitig, nie in Git; in der Google Cloud Console auf die
# "Cloud Text-to-Speech API" beschränken.
PICASTAI_TTS_PROVIDER=
PICASTAI_GOOGLE_TTS_KEY=
# Leer = de-DE-Chirp3-HD-Algenib (männlich, im Hörtest gewählt)
PICASTAI_GOOGLE_TTS_VOICE=
# Tempo 0.25 bis 2.0, leer = 0.95
PICASTAI_GOOGLE_TTS_RATE=
PICASTAI_VOICE_TIMEOUT_MS=45000

# ------------------------------------------------------------------------------
# 3. Erzähl- & Pädagogik-Parameter
# ------------------------------------------------------------------------------
# Alterszielgruppe für Wortwahl und Satzkomplexität (Standard: sechs bis zehn)
KUNIBERT_AGE=sechs bis zehn
# Anzahl der Kapitel/Teile pro Folge (Standard: 5 Teile)
# Phase 1: Start (Dachzimmer/Aufbruch) -> 2-3: Mitte (Wald/Hexe) -> 4: List -> 5: Finale/Heimkehr
KUNIBERT_PARTS_PER_EPISODE=5
# Wortanzahl-Grenzen für Geschichten
KUNIBERT_STORY_MIN_WORDS=170
KUNIBERT_STORY_MAX_WORDS=230
# Maximale Wortanzahl für Antworten auf Kinderfragen
KUNIBERT_ANSWER_MAX_WORDS=80

# ------------------------------------------------------------------------------
# 4. Kinderschutz & Notfall-Konfiguration
# ------------------------------------------------------------------------------
# Primäre Notrufnummer als Wortlaut für Sprachsynthese (Standard: Eins Eins Zwei)
KUNIBERT_EMERGENCY_NUMBER_PRIMARY=Eins Eins Zwei
# Kummernummer für Kinderberatung (Standard: Eins Eins Sechs, Eins Eins Eins)
KUNIBERT_EMERGENCY_NUMBER_KUMMER=Eins Eins Sechs, Eins Eins Eins

# ------------------------------------------------------------------------------
# 5. Datensparsamkeit & Flüchtiger Audiospeicher
# ------------------------------------------------------------------------------
# Gültigkeitsdauer für erzeugte WAV-Antworten im Arbeitsspeicher in Sekunden (TTL)
# Nach diesem Zeitraum oder nach einmaligem Abruf durch das Gerät gelöscht.
KUNIBERT_AUDIO_TTL=120
# Audio-Abtastrate in Hertz (Pi-Hardware-Standard: 16000 Hz, mono, 16-bit PCM)
KUNIBERT_AUDIO_SAMPLE_RATE=16000
# Rate-Limiter: Maximale Anzahl von Turns pro Gerät innerhalb des Zeitfensters
KUNIBERT_RATE_LIMIT=30
# Zeitfenster für den Rate-Limiter in Sekunden (600 s = 10 Minuten)
KUNIBERT_RATE_LIMIT_WINDOW=600

# ------------------------------------------------------------------------------
# 6. Diagnose & Geräteverwaltung
# ------------------------------------------------------------------------------
# Diagnose-Text nur in Entwicklung nach ausdrücklichem Opt-in ausgeben (1 = an, 0 = aus)
KUNIBERT_DIAGNOSTIC_TEXT=0
# Ablage der Geräteliste: memory (Standard, flüchtig) oder firestore (dauerhaft).
# Bei firestore startet der Server nur, wenn die Liste geladen werden kann.
PICASTAI_DEVICE_STORE=memory
