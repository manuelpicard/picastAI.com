rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Direkte Firebase-Clientzugriffe sind deaktiviert.
    // Serverseitige Zugriffe mit Firebase Admin SDK laufen außerhalb dieser Regeln.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
